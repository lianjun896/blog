[
    // ============================================================
    // 个人资料配置文件 user_profiles.json（左上角用户信息 + 资料弹窗）
    // ------------------------------------------------------------
    // 每个对象对应一个账号（username 必须与 users.json 里的账号一致）
    // 可修改项说明：
    //   avatar      头像图片的文件名（把图片放到本项目根目录，如 LJ.ico，
    //              或 avatars/xxx.png；留空 "" 则显示首字母彩色圆头像）
    //   nickname    昵称（显示在左上角姓名处）
    //   signature   个性签名（显示在姓名下方）
    //   gender      性别 | region 地区 | birthday 生日 | constellation 星座
    //   email 邮箱 | occupation 职业 | hobby 爱好 | bio 个人简介
    //   tags        个性标签（数组，可多个） | level 等级 | memberSince 加入时间
    // ------------------------------------------------------------
    // ★ 想增加新的资料项？直接在对应对象里加一行即可，例如：
    //     "school": "某某大学",
    //   页面资料弹窗会自动显示这一项（字段名会作为标签显示）。
    //   字符串用双引号，最后一个字段后面不要加逗号。
    // ============================================================

    {
        "username": "LJ",                         // 登录账号（与 users.json 一致）
        "nickname": "LJ",                         // 昵称
        "avatar": "LJ.ico",                       // 头像图片文件名（示例：项目里的 LJ.ico）
        "signature": "个性签名：未知",          // 个性签名
        "gender": "性别：未知",                           // 性别
        "region": "地区：未知",                   // 地区

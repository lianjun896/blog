[
    // ============================================================
    // 账号配置文件 users.json（登录用）
    // ------------------------------------------------------------
    // 在这里增删 / 修改账号：
    //   username —— 登录账号
    //   password —— 登录密码
    // 注意：
    //   1. 以 // 开头的是注释，可以随便写，不影响运行
    //   2. 字符串必须用双引号 " "
    //   3. 同一对象的最后一个字段后面不要加逗号
    // ============================================================

    {
        "username": "LJ",        // 账号 LJ
        "password": "123456"   // 密码
    },
    {
        "username": "YL",        // 账号 YL
        "password": "123456"   // 密码
    }
    // 想加新账号？照着上面再写一个 { "username": "账号", "password": "密码" } 即可
]

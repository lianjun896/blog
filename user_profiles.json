        "occupation": "职业：未知",                         // 职业
        "hobby": "爱好：未知",                // 爱好
        "bio": "个人简介：未知", // 个人简介
        "tags": ["人"],        // 个性标签
        "level": "LV.14",                          // 等级
        "memberSince": "2026-08-31"               // 加入时间
